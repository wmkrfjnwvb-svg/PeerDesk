# PeerDesk 世界文件：一次仿真会话的全部输入（格式见 crates/e2e/src/world.rs）。
# 文件名是内容哈希；结果只由这里的内容决定，不受环境变量影响。
world 1
name ms-02651
width 1280
height 720
fps 30
codec h264
byte_model default
rng_layout 1
seed 6
estimator v1
profile wireless
policy office
start_bps 1000000
max_bps 30000000
pacing 0
fec rs
start_probe 1
probe_ids 1
phases 22
phase.0 action=idle frames=30
phase.1 action=typing frames=90
phase.2 action=idle frames=30
phase.3 action=scrolling frames=60
phase.4 action=idle frames=30
phase.5 action=dragging frames=60
phase.6 action=idle frames=30
phase.7 action=switching frames=15
phase.8 action=idle frames=30
phase.9 action=video frames=90
phase.10 action=idle frames=30
phase.11 action=idle frames=30
phase.12 action=typing frames=90
phase.13 action=idle frames=30
phase.14 action=scrolling frames=60
phase.15 action=idle frames=30
phase.16 action=dragging frames=60
phase.17 action=idle frames=30
phase.18 action=switching frames=15
phase.19 action=idle frames=30
phase.20 action=video frames=90
phase.21 action=idle frames=30
links 4
link.0 at=0 delay_us=25000 jitter_us=3000 fifo_jitter=0 batch_us=0 loss_permille=0 rate_bps=914000 max_queue_us=200000 up=1 spikes=- doze=- busy=-
link.1 at=12060000 delay_us=25000 jitter_us=3000 fifo_jitter=0 batch_us=0 loss_permille=0 rate_bps=1091128 max_queue_us=200000 up=1 spikes=- doze=- busy=-
link.2 at=12120000 delay_us=25000 jitter_us=3000 fifo_jitter=0 batch_us=0 loss_permille=0 rate_bps=1280000 max_queue_us=200000 up=1 spikes=- doze=- busy=-
link.3 at=39900000 delay_us=25000 jitter_us=3000 fifo_jitter=0 batch_us=0 loss_permille=0 rate_bps=1021746 max_queue_us=200000 up=1 spikes=- doze=- busy=-
